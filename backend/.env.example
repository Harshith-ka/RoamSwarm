# RoamSwarm Environment Configuration
PORT=8000
ENVIRONMENT=development

# Gemini API Key (Optional for mock/offline mode, required for live Gemini LLM & TTS)
GEMINI_API_KEY=

# Tavily Search API Key (Optional, falls back to Wikipedia & DuckDuckGo)
TAVILY_API_KEY=

# LangSmith Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=RoamSwarm

# Database URL (Defaults to SQLite for instant local execution, supports PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./roamswarm.db

# OpenStreetMap User Agent for Nominatim compliance
OSM_USER_AGENT=RoamSwarm-Agentic-Urban-Engine/1.0 (contact: info@roamswarm.local)

# Cache TTL in seconds (Default: 24 hours for POI and historical data)
CACHE_TTL_SECONDS=86400
